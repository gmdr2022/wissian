# Catalogo proposto, sem consumidor implementado. Nao inicia nenhum ambiente.
# No bootstrap, dividir por aplicacao e validar obrigatoriedade no servidor.
# Nunca preencher este arquivo versionado com valores reais.

# API: URL de conexao de uma role de runtime com privilegios minimos.
# O processo web nao deve receber esta variavel.
DATABASE_URL=

# Migrador: credencial separada, acessivel somente ao job de migracao.
# Nao injetar no processo da API nem no frontend.
MIGRATION_DATABASE_URL=

# Origem do navegador e endereco interno da API; resolver no plano de ambiente.
WEB_ORIGIN=
API_INTERNAL_URL=

# Integracao de identidade: nomes candidatos, provedor ainda nao escolhido.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Nenhum segredo pode usar prefixo NEXT_PUBLIC_.
# Futuras variaveis publicas devem conter somente informacao publicavel.
